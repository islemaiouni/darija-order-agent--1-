# Public HTTPS URL from ngrok (no trailing slash). Update it every time ngrok restarts.
PUBLIC_BASE_URL=https://YOUR-NGROK-DOMAIN.ngrok-free.app

# Twilio Console -> Account SID / Auth Token / your Twilio phone number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# true for first local tests only. Set false in production.
SKIP_TWILIO_SIGNATURE_VALIDATION=true

# Deepgram (speech-to-text). ar-DZ, falls back to "ar" automatically if rejected.
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_LANGUAGE=ar-DZ

# OpenAI (intent + Darija reply)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Azure AI Speech (text-to-speech)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=ar-DZ-IsmaelNeural

# Local database (free, zero setup)
DATABASE_PATH=./agent.db
MAX_TURNS=5

# Safety for the public demo form (calls cost money!)
# Comma-separated numbers allowed to receive calls. LEAVE IT SET while testing.
ALLOWED_PHONES=+2135XXXXXXXX
COOLDOWN_MINUTES=5

# OPTIONAL: also copy every order to Supabase (free tier). Leave empty to skip.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
